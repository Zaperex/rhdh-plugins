{
  "name": "plugin-cdn-backend",
  "version": "0.0.1-next.0",
  "description": "A Backstage backend plugin that allows changing the public path of Module Federation frontend assets",
  "backstage": {
    "role": "backend-plugin",
    "pluginId": "cdn",
    "pluginPackages": [
      "plugin-cdn-backend"
    ]
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "backstage"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/backstage/backstage",
    "directory": "my-plugins/plugin-cdn-backend"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "package.json": [
        "package.json"
      ]
    }
  },
  "main": "src/index.ts",
  "files": [
    "dist",
    "config.d.ts"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck true --incremental false",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "dependencies": {
    "@backstage/backend-dynamic-feature-service": "0.8.0",
    "@backstage/backend-plugin-api": "1.8.0",
    "@backstage/config": "1.3.6"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.0",
    "typescript": "~5.3.0"
  },
  "configSchema": "config.d.ts",
  "packageManager": "yarn@4.12.0"
}
